PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_ANON_KEY=your-anon-public-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Google Cloud project > OAuth consent screen (Testing mode is fine,
# drive.file is a non-sensitive scope) > Web OAuth Client ID. Must exactly
# match what's registered there. The client ID/secret themselves are NOT
# env vars — they're stored in Supabase Vault (see schema.sql's
# get_app_secret()/vault.create_secret() section) so they're encrypted at
# rest and only readable by the backend's service-role client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/google-drive/callback
