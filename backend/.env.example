PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_ANON_KEY=your-anon-public-key
# Preferred, if set: Groq (console.groq.com/keys) — much faster inference.
# Free tier has a 100,000 tokens/day cap per model.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback, used only when GROQ_API_KEY is unset: OpenRouter — slower on
# free-tier models but a much wider model selection.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
